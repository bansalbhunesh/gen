{
  "name": "stadiumiq-2026",
  "version": "1.0.0",
  "description": "GenAI-powered Stadium Operations & Fan Experience platform for the FIFA World Cup 2026 — multilingual concierge, wayfinding, crowd/operational intelligence, accessibility and sustainability support.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_ENV=test node --test",
    "test:coverage": "NODE_ENV=test node --test --experimental-test-coverage",
    "test:watch": "NODE_ENV=test node --test --watch",
    "lint": "node --check src/server.js && echo \"syntax OK\""
  },
  "keywords": [
    "genai",
    "fifa-world-cup-2026",
    "stadium-operations",
    "accessibility",
    "multilingual",
    "wayfinding",
    "crowd-management",
    "operational-intelligence"
  ],
  "author": "StadiumIQ Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0"
  }
}
